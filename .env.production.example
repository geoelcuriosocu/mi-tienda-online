# ============================================================================
# LaLomita — plantilla de configuración para PRODUCCIÓN
# ============================================================================
# Copiá este archivo a .env en el servidor y completá los valores reales.
# NUNCA subas el archivo .env a Git (ya está excluido en .gitignore).
# Después de copiarlo ejecutá: php artisan key:generate
# Luego: php artisan bagisto:install --force --no-interaction
# (con BAGISTO_ADMIN_EMAIL y BAGISTO_ADMIN_PASSWORD definidos más abajo)
# ============================================================================

APP_NAME=LaLomita
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# URL pública con HTTPS y certificado válido.
APP_URL=https://tudominio.com
APP_ADMIN_URL=admin

# Zona horaria IANA de la tienda. Cambiala según el país de operación.
# Ejemplos: America/Havana, America/Mexico_City, Europe/Madrid, UTC
APP_TIMEZONE=UTC

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_CURRENCY=USD
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Errores: sin volcados al navegador; se registran en archivos.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# base de datos: mantener credenciales solo en el .env del servidor.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

# Credenciales del primer administrador: OBLIGATORIAS en producción.
# Usá un correo real y una contraseña larga y única. No las compartas.
BAGISTO_ADMIN_EMAIL=
BAGISTO_ADMIN_PASSWORD=

# Sesiones y cookies seguras bajo HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=

# Correo: Bagisto usa el transporte dinámico configurado desde el panel.
# Si preferís SMTP fijo, configurá también MAIL_HOST/MAIL_PORT/MAIL_USERNAME/MAIL_PASSWORD.
MAIL_MAILER=bagisto-dynamic-smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@tudominio.com
MAIL_FROM_NAME=LaLomita
ADMIN_MAIL_ADDRESS=admin@tudominio.com
ADMIN_MAIL_NAME=LaLomita
CONTACT_MAIL_ADDRESS=contacto@tudominio.com
CONTACT_MAIL_NAME=LaLomitao

# Integraciones opcionales (AWS S3, Cloudflare R2, Redis, Reverb, Pusher):
# si las usás, copiá sus variables desde .env.example y completalas aquí.
